OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENAI_DRAFT_MODEL=gpt-5.5
OPENAI_MINI_MODEL=gpt-5.4-mini
OPENAI_TEXT_MODEL_FALLBACKS=gpt-5.5,gpt-5.4,gpt-5.4-mini
OPENAI_JSON_MODEL_FALLBACKS=gpt-5.4-mini,gpt-5.4,gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
MISTRAL_OCR_MODEL=mistral-ocr-latest
LOCAL_ACCELERATOR=auto
LOCAL_CUDA_MIN_CAPABILITY=75
# Override these only when you want to force a specific device.
# LOCAL_OCR_DEVICE=cpu
# LOCAL_EMBEDDING_DEVICE=cpu
# LOCAL_RERANK_DEVICE=cpu
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=900
OLLAMA_STREAM=true
OLLAMA_THINK=false
OLLAMA_MAX_OUTPUT_TOKENS=800
OLLAMA_EVIDENCE_LIMIT=7
OLLAMA_CHUNK_CHARS=550
OLLAMA_NUM_THREAD=8
OLLAMA_NUM_CTX=3072
OLLAMA_SUMMARY_CHARS=1800
OLLAMA_FALLBACK_ON_INVALID=true
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_BATCH_SIZE=4
LOCAL_EMBEDDING_FALLBACK=false
LOCAL_RERANK_MODEL=BAAI/bge-reranker-base
LOCAL_RERANK_BATCH_SIZE=8
LOCAL_RERANK_TOP_N=10
LOCAL_RERANK_TEXT_CHARS=1200
LOCAL_RERANK_WEIGHT=0.25
LOCAL_RERANK_PROTECT_TOP=2
INGEST_WORKERS=1
